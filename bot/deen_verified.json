{
 "duas": {
  "0": {
   "arabic": "بِسْمِ اللَّهِ",
   "from": "Hisn al-Muslim: الدعاء قبل الطعام",
   "source_text": "بِسْمِ اللَّهِ"
  },
  "1": {
   "arabic": "بِسْمِ اللَّهِ فِي أَوَّلِهِ وَآخِرِهِ",
   "from": "Hisn al-Muslim: الدعاء قبل الطعام",
   "source_text": "بسمِ اللَّهِ فِي أَوَّلِهِ وَآخِرِهِ"
  },
  "2": {
   "arabic": "الْحَمْدُ لِلَّهِ الَّذِي أَطْعَمَنِي هَذَا وَرَزَقَنِيهِ مِنْ غَيْرِ حَوْلٍ مِنِّي وَلَا قُوَّةٍ",
   "from": "Hisn al-Muslim: الدعاء عند الفراغ من الطعام",
   "source_text": "الْحَمْدُ لِلَّهِ الَّذِي أَطْعَمَنِي هَذَا، وَرَزَقَنِيهِ، مِنْ غَيْرِ حَوْلٍ مِنِّي وَلاَ قُوَّةٍ"
  },
  "3": {
   "arabic": "بِاسْمِكَ اللَّهُمَّ أَمُوتُ وَأَحْيَا",
   "from": "Hisn al-Muslim: أذكار النوم",
   "source_text": "بِاسْمِكَ اللَّهُمَّ أَمُوتُ وَأَحْيَا"
  },
  "4": {
   "arabic": "الْحَمْدُ لِلَّهِ الَّذِي أَحْيَانَا بَعْدَ مَا أَمَاتَنَا وَإِلَيْهِ النُّشُورُ",
   "from": "Hisn al-Muslim: أذكار الاستيقاظ من النوم",
   "source_text": "الْحَمْدُ للَّهِ الَّذِي أَحْيَانَا بَعْدَ مَا أَمَاتَنَا، وَإِلَيْهِ النُّشُورُ"
  },
  "5": {
   "arabic": "بِسْمِ اللَّهِ تَوَكَّلْتُ عَلَى اللَّهِ وَلَا حَوْلَ وَلَا قُوَّةَ إِلَّا بِاللَّهِ",
   "from": "Hisn al-Muslim: الذكر عند الخروج من المنزل",
   "source_text": "بِسْمِ اللَّهِ، تَوَكَّلْتُ عَلَى اللَّهِ، وَلَاَ حَوْلَ وَلَا قُوَّةَ إِلاَّ بِاللَّهِ"
  },
  "6": {
   "arabic": "اللَّهُمَّ إِنِّي أَعُوذُ بِكَ مِنَ الْخُبْثِ وَالْخَبَائِثِ",
   "from": "Hisn al-Muslim: دعاء دخول الخلاء",
   "source_text": "اللَّهُمَّ إِنِّي أَعُوذُ بِكَ مِنَ الْخُبْثِ وَالْخَبائِث"
  },
  "7": {
   "arabic": "غُفْرَانَكَ",
   "from": "Hisn al-Muslim: دعاء الخروج من الخلاء",
   "source_text": "غُفْرَانَكَ"
  },
  "8": {
   "arabic": "اللَّهُمَّ افْتَحْ لِي أَبْوَابَ رَحْمَتِكَ",
   "from": "Hisn al-Muslim: دعاء دخول المسجد",
   "source_text": "اللَّهُمَّ افْتَحْ لِي أَبْوَابَ رَحْمَتِكَ"
  },
  "9": {
   "arabic": "اللَّهُمَّ إِنِّي أَسْأَلُكَ مِنْ فَضْلِكَ",
   "from": "Hisn al-Muslim: دعاء الخروج من المسجد",
   "source_text": "اللَّهُمَّ إِنِّي أَسْأَلُكَ مِنْ فَضْلِك"
  },
  "10": {
   "arabic": "رَبَّنَا آتِنَا فِي الدُّنْيَا حَسَنَةً وَفِي الْآخِرَةِ حَسَنَةً وَقِنَا عَذَابَ النَّارِ",
   "from": "Quran 2:201 (quran.com)"
  },
  "11": {
   "arabic": "رَبِّ زِدْنِي عِلْمًا",
   "from": "Quran 20:114 (quran.com)"
  },
  "12": {
   "arabic": "رَبِّ اشْرَحْ لِي صَدْرِي وَيَسِّرْ لِي أَمْرِي",
   "from": "Quran 20:25+20:26 (quran.com)"
  },
  "13": {
   "arabic": "رَبِّ ارْحَمْهُمَا كَمَا رَبَّيَانِي صَغِيرًا",
   "from": "Quran 17:24 (quran.com)"
  },
  "14": {
   "arabic": "حَسْبُنَا اللَّهُ وَنِعْمَ الْوَكِيلُ",
   "from": "Quran 3:173 (quran.com)"
  },
  "15": {
   "arabic": "لَا إِلَٰهَ إِلَّا أَنتَ سُبْحَانَكَ إِنِّي كُنتُ مِنَ الظَّالِمِينَ",
   "from": "Quran 21:87 (quran.com)"
  },
  "16": {
   "arabic": "سُبْحَانَ الَّذِي سَخَّرَ لَنَا هَٰذَا وَمَا كُنَّا لَهُ مُقْرِنِينَ وَإِنَّا إِلَىٰ رَبِّنَا لَمُنقَلِبُونَ",
   "from": "Quran 43:13+43:14 (quran.com)"
  },
  "17": {
   "arabic": "إِنَّا لِلَّهِ وَإِنَّا إِلَيْهِ رَاجِعُونَ",
   "from": "Quran 2:156 (quran.com)"
  },
  "18": {
   "arabic": "رَبَّنَا ظَلَمْنَا أَنفُسَنَا وَإِن لَّمْ تَغْفِرْ لَنَا وَتَرْحَمْنَا لَنَكُونَنَّ مِنَ الْخَاسِرِينَ",
   "from": "Quran 7:23 (quran.com)"
  },
  "19": {
   "arabic": "أَسْتَغْفِرُ اللَّهَ وَأَتُوبُ إِلَيْهِ",
   "from": "Hisn al-Muslim: أذكار الصباح والمساء",
   "source_text": "أَسْتَغْفِرُ اللَّهَ وَأَتُوبُ إِلَيْهِ"
  },
  "20": {
   "arabic": "الْحَمْدُ لِلَّهِ الَّذِي كَسَانِي هَذَا الثَّوْبَ وَرَزَقَنِيهِ مِنْ غَيْرِ حَوْلٍ مِنِّي وَلَا قُوَّةٍ",
   "from": "Hisn al-Muslim: دعاء ُلبْس الثوب",
   "source_text": "الْحَمْدُ للَّهِ الَّذِي كَسَانِي هَذَا الثَّوْبَ وَرَزَقَنِيهِ مِنْ غَيْرِ حَوْلٍ مِنِّي وَلاَ قُوَّة"
  },
  "21": {
   "arabic": "اللَّهُمَّ إِنِّي أَعُوذُ بِكَ مِنَ الْهَمِّ وَالْحَزَنِ وَالْعَجْزِ وَالْكَسَلِ وَالْبُخْلِ وَالْجُبْنِ وَضَلَعِ الدَّيْنِ وَغَلَبَةِ الرِّجَالِ",
   "from": "Hisn al-Muslim: دعاء الهم والحزن",
   "source_text": "اللَّهُمَّ إِنِّي أَعُوذُ بِكَ مِنَ الْهَمِّ وَالْحَزَنِ، وَالْعَجْزِ وَالْكَسَلِ، وَالْبُخْلِ وَالْجُبْنِ، وَضَلَعِ الدَّيْنِ وَغَلَبَةِ الرِّجَالِ"
  },
  "22": {
   "arabic": "رَبَّنَا هَبْ لَنَا مِنْ أَزْوَاجِنَا وَذُرِّيَّاتِنَا قُرَّةَ أَعْيُنٍ وَاجْعَلْنَا لِلْمُتَّقِينَ إِمَامًا",
   "from": "Quran 25:74 (quran.com)"
  },
  "23": {
   "arabic": "رَبِّ اجْعَلْنِي مُقِيمَ الصَّلَاةِ وَمِن ذُرِّيَّتِي ۚ رَبَّنَا وَتَقَبَّلْ دُعَاءِ",
   "from": "Quran 14:40 (quran.com)"
  },
  "24": {
   "arabic": "رَبَّنَا تَقَبَّلْ مِنَّا ۖ إِنَّكَ أَنتَ السَّمِيعُ الْعَلِيمُ",
   "from": "Quran 2:127 (quran.com)"
  },
  "25": {
   "arabic": "رَبِّ إِنِّي لِمَا أَنزَلْتَ إِلَيَّ مِنْ خَيْرٍ فَقِيرٌ",
   "from": "Quran 28:24 (quran.com)"
  },
  "26": {
   "arabic": "رَبَّنَا لَا تُزِغْ قُلُوبَنَا بَعْدَ إِذْ هَدَيْتَنَا وَهَبْ لَنَا مِن لَّدُنكَ رَحْمَةً ۚ إِنَّكَ أَنتَ الْوَهَّابُ",
   "from": "Quran 3:8 (quran.com)"
  },
  "27": {
   "arabic": "أَعُوذُ بِاللَّهِ مِنَ الشَّيْطَانِ الرَّجِيمِ",
   "from": "Hisn al-Muslim: دعاء الغضب",
   "source_text": "أَعُوذُ بِاللَّهِ مِنَ الشَّيْطَانِ الرَّجِيمِ"
  },
  "28": {
   "arabic": "لَا بَأْسَ طَهُورٌ إِنْ شَاءَ اللَّهُ",
   "from": "Hisn al-Muslim: الدعاء للمريض في عيادته",
   "source_text": "لاَ بأْسَ طَهُورٌ إِنْ شَاءَ اللَّهُ"
  },
  "29": {
   "arabic": "بَارَكَ اللَّهُ لَكَ وَبَارَكَ عَلَيْكَ وَجَمَعَ بَيْنَكُمَا فِي خَيْرٍ",
   "from": "Hisn al-Muslim: الدعاء للمتزوج",
   "source_text": "بَارَكَ اللَّهُ لَكَ، وَبَارَكَ عَلَيْكَ، وَجَمَعَ بَيْنَكُمَا فِي خَيْرٍ"
  },
  "30": {
   "arabic": "ذَهَبَ الظَّمَأُ وَابْتَلَّتِ الْعُرُوقُ وَثَبَتَ الْأَجْرُ إِنْ شَاءَ اللَّهُ",
   "from": "Hisn al-Muslim: الدعاء عند إفطار الصائم",
   "source_text": "ذَهَبَ الظَّمَأُ وَابْتَلَّتِ العُرُوقُ، وَثَبَتَ الْأَجْرُ إِنْ شَاءَ اللَّهُ"
  },
  "31": {
   "arabic": "اللَّهُمَّ صَيِّبًا نَافِعًا",
   "from": "Hisn al-Muslim: الدعاء إذا نزل المطر",
   "source_text": "اللَّهُمَّ صَيِّباً نَافِعاً"
  },
  "32": {
   "arabic": "بِسْمِ اللَّهِ الَّذِي لَا يَضُرُّ مَعَ اسْمِهِ شَيْءٌ فِي الْأَرْضِ وَلَا فِي السَّمَاءِ وَهُوَ السَّمِيعُ الْعَلِيمُ",
   "from": "Hisn al-Muslim: أذكار الصباح والمساء",
   "source_text": "بِسْمِ اللَّهِ الَّذِي لاَ يَضُرُّ مَعَ اسْمِهِ شَيْءٌ فِي الْأَرْضِ وَلاَ فِي السّمَاءِ وَهُوَ السَّمِيعُ الْعَلِيمُ"
  },
  "33": {
   "arabic": "سُبْحَانَ اللَّهِ وَبِحَمْدِهِ سُبْحَانَ اللَّهِ الْعَظِيمِ",
   "from": "Hisn al-Muslim: فضل التسبيح و التحميد، و التهليل، و التكبير",
   "source_text": "سُبْحَانَ اللَّهِ وَبِحَمْدِهِ، سُبْحانَ اللَّهِ الْعَظِيمِ"
  },
  "34": {
   "arabic": "لَا حَوْلَ وَلَا قُوَّةَ إِلَّا بِاللَّهِ",
   "from": "Hisn al-Muslim: أذكار الآذان",
   "source_text": "لاَ حَوْلَ وَلاَ قُوَّةَ إِلاَّ بِاللَّهِ"
  },
  "35": {
   "arabic": "الْحَمْدُ لِلَّهِ",
   "from": "Hisn al-Muslim: دعاء العطاس",
   "source_text": "الْحَمْدُ لِلَّهِ"
  }
 },
